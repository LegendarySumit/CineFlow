      "scene_number": 1,
      "scene_title": "Monsoon Arrives at Arambol Beach",
      "description": "Aditya arrives at Arambol Beach during early monsoon. Dark clouds gather over the Arabian Sea. He stands alone on the beach, contemplating his past decisions. The waves crash violently. Emotional moment establishing his internal conflict and the film's core theme of redemption.",
      "story_significance": "CRITICAL",
      "shooting_schedule": {
        "shoot_date": "2026-09-01",
        "time_of_day": "DAWN",
        "duration_hours": 4,
        "estimated_shots": 12
      },
      "cast_required": ["actor_001"],
      "equipment_required": ["eq_camera_001", "eq_sound_001"],
      "location_id": "loc_beach_001",
      "dependencies": "None",
      "contingency": "If weather severe, can reschedule to sc_001B (indoor dream sequence)"
    },
    {
