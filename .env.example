# CineFlow Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# API KEYS (Required)
# ============================================================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel Search MCP API Key
# Get from: https://parallel.com/dashboard
PARALLEL_API_KEY=your_parallel_api_key_here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Gemini Model to use
GEMINI_MODEL=gemini-3-flash-preview

# Maximum refinement attempts (self-correction loops)
# 0 = Free tier (no self-correction)
# 2 = Paid tier (enables reflection & refinement)
MAX_REFINEMENTS=0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# API Server Host
HOST=0.0.0.0

# API Server Port
PORT=8000

# ============================================================================
# DATABASE CONFIGURATION (Optional - for production)
# ============================================================================

# Database URL (when migrating from JSON fixtures)
# DATABASE_URL=postgresql://user:password@localhost/cineflow

# Redis URL (for session store scaling)
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed request/response logging
DEBUG_MODE=false

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable CORS for development
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:8000"]
