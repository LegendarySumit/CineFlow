# CineFlow Local Environment Configuration
# Copy this file to .env and fill in your own values
# NEVER commit .env to version control - it's already in .gitignore

# Google Gemini API Key (get from https://gemini.google.com/app)
GEMINI_API_KEY=your_api_key_here

# Parallel Search MCP API Key (optional)
PARALLEL_API_KEY=your_parallel_api_key_here

# Model Configuration
# Using Gemini 3.5 Flash-Lite: Latest free tier model with high quota
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum refinement attempts (self-correction loops)
# 0 = Free tier, 2 = Paid tier with full agentic behavior
MAX_REFINEMENTS=0

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG_MODE=false
